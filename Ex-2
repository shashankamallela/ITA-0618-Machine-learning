data = [
    ["Sunny","Warm","Normal","Strong","Warm","Same","Yes"],
    ["Sunny","Warm","High","Strong","Warm","Same","Yes"],
    ["Rainy","Cold","High","Strong","Warm","Change","No"],
    ["Sunny","Warm","High","Strong","Cool","Change","Yes"]
]

n = 6
S = ["Ø"] * n
G = [["?"] * n]

def covers(h, x):
    return all(a == "?" or a == b for a,b in zip(h,x))

def more_general_or_equal(a,b):
    return all(x == "?" or x == y for x,y in zip(a,b))

for row in data:
    x, label = row[:-1], row[-1]

    if label == "Yes":
        G = [g for g in G if covers(g,x)]

        for i in range(n):
            if S[i] == "Ø":
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = "?"

        G = [g for g in G if more_general_or_equal(g,S)]

    else:
        new_G = []

        for g in G:
            if covers(g,x):
                for i in range(n):
                    if g[i] == "?" and S[i] != "?" and S[i] != "Ø" and S[i] != x[i]:
                        spec = g.copy()
                        spec[i] = S[i]

                        if more_general_or_equal(spec,S):
                            new_G.append(spec)
            else:
                new_G.append(g)

        G = new_G

print("Specific Boundary S:", S)
print("General Boundary G:", G)
