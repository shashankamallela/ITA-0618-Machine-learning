from sklearn.ensemble import RandomForestRegressor

cars = pd.DataFrame({
    "age":[1,2,3,4,5,6,7,8,2,4,6,9,3,5,7,10,1,3,8,9],
    "km":[5000,12000,20000,28000,35000,45000,52000,65000,15000,30000,48000,80000,22000,38000,60000,95000,7000,18000,70000,85000],
    "engine_cc":[1200,1200,1500,1500,1200,1800,1500,1200,1800,1500,1800,1200,1200,1800,1500,1800,1500,1200,1800,1500],
    "price":[900,850,780,700,650,600,520,450,820,690,560,380,760,620,480,300,920,790,410,350]
})

X = cars.drop(columns="price")
y = cars["price"]

reg = RandomForestRegressor(
    n_estimators=150,
    random_state=42
)

reg.fit(X,y)

print("Training R2:", reg.score(X,y))

new_car = pd.DataFrame(
    [[3,25000,1500]],
    columns=X.columns
)

print("Predicted Car Price:",
      reg.predict(new_car)[0],
      "thousand")
